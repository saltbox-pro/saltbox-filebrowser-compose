server:
  port: 80
  database: /home/filebrowser/database.db
  sources:
    # `readOnly` / `hiddenFromUi` are UI hints only; they are stripped from the
    # config passed to FileBrowser and applied in `/public/api/users` by the proxy
    - path: "/srv/config_boxes/"
      name: "Custom Config Boxes"
      readOnly: false
      config:
        denyByDefault: false
        private: false
        disabled: false
        indexingIntervalMinutes: 0
        disableIndexing: false
        conditionals:
          hidden: false
          ignoreHidden: false
          ignoreZeroSizeFolders: false
        defaultEnabled: true
        createUserDir: false
    - path: "/srv/salt_custom/"
      name: "Salt Custom"
      readOnly: false
      config:
        denyByDefault: false
        private: false
        disabled: false
        indexingIntervalMinutes: 0
        disableIndexing: false
        conditionals:
          hidden: false
          ignoreHidden: false
          ignoreZeroSizeFolders: false
          rules:
            - folderPath: "client-fm-uploads"
            - folderName: "client-fm-uploads"
            - neverWatchPath: "client-fm-uploads"
        defaultEnabled: true
        createUserDir: false
    # Internal: client file-manager upload staging (same files as salt://client-fm-uploads/).
    # Hidden from the File Manager UI; Salt Custom also ignores that folder name.
    - path: "/srv/salt_custom/client-fm-uploads/"
      name: "Client FM Uploads"
      readOnly: false
      hiddenFromUi: true
      config:
        denyByDefault: false
        private: true
        disabled: false
        indexingIntervalMinutes: 0
        disableIndexing: true
        conditionals:
          hidden: false
          ignoreHidden: false
          ignoreZeroSizeFolders: false
        defaultEnabled: true
        createUserDir: false
    # Internal: client file-manager download via cp.push recv-cache.
    # `hiddenFromUi` is stripped like `readOnly` and hides the source in File Manager.
    - path: "/srv/minion_file_recv/"
      name: "Minion Recv"
      readOnly: true
      hiddenFromUi: true
      config:
        denyByDefault: false
        private: true
        disabled: false
        indexingIntervalMinutes: 0
        disableIndexing: true
        conditionals:
          hidden: false
          ignoreHidden: false
          ignoreZeroSizeFolders: false
        defaultEnabled: true
        createUserDir: false
    # RW access is danger!
    - path: "/srv/saltbox_salt/"
      name: "Config Boxes"
      readOnly: true
      config:
        denyByDefault: false
        private: false
        disabled: false
        indexingIntervalMinutes: 0
        disableIndexing: false
        conditionals:
          hidden: false
          ignoreHidden: false
          ignoreZeroSizeFolders: false
        defaultEnabled: true
        createUserDir: false
    # RW access is danger!
    - path: "/srv/sshfs/"
      name: "SSHFS"
      readOnly: true
      config:
        denyByDefault: false
        private: false
        disabled: false
        indexingIntervalMinutes: 0
        disableIndexing: false
        conditionals:
          hidden: false
          ignoreHidden: false
          ignoreZeroSizeFolders: false
        defaultEnabled: true
        createUserDir: false
${MIGRATOR_SOURCE_BLOCK}
  logging:
    # Terminal
    - output: stdout
      levels: "info|warning|error"
      apiLevels: disabled
    # API logs
    - output: "api-events.log"
      levels: disabled
    # Errors
    - output: "errors.log"
      levels: "error|warning"
      apiLevels: disabled
auth:
  methods:
    noauth: true
userDefaults:
  editorQuickSave: true
  hideSidebarFileActions: false
  disableQuickToggles: false
  disableSearchOptions: false
  darkMode: false
  locale: "en"
  showHidden: true
  quickDownload: true
  preview:
    disableHideSidebar: false
    highQuality: true
    image: true
    video: true
    motionVideoPreview: true
    popup: true
    autoplayMedia: true
    defaultMediaPlayer: false
    folder: true
  permissions:
    api: true
    admin: true
    modify: true
    share: true
    realtime: true
    delete: true
    create: true
    download: true
