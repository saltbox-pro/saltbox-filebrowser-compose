http:
  port: 80
  trustProxyHeaders: true
server:
  database:
    path: /home/filebrowser/data/database.sqlite
  sources:
    - path: "/srv/config_boxes/"
      name: "Custom Config Boxes"
      config:
        denyByDefault: false
        private: false
        disabled: false
        defaultEnabled: true
        createUserDir: false
        defaultPermissions:
          view: true
          download: true
          modify: true
          delete: true
          create: true
          configured: true
    - path: "/srv/salt_custom/"
      name: "Salt Custom"
      config:
        denyByDefault: false
        private: false
        disabled: false
        defaultEnabled: true
        createUserDir: false
        defaultPermissions:
          view: true
          download: true
          modify: true
          delete: true
          create: true
          configured: true
    - path: "/srv/saltbox_salt/"
      name: "Saltbox Salt"
      config:
        denyByDefault: false
        private: false
        disabled: false
        defaultEnabled: true
        createUserDir: false
        defaultPermissions:
          view: true
          download: true
          modify: false
          delete: false
          create: false
          configured: true
    - path: "/srv/sshfs/"
      name: "SSHFS"
      config:
        denyByDefault: false
        private: false
        disabled: false
        defaultEnabled: true
        createUserDir: false
        defaultPermissions:
          view: true
          download: true
          modify: false
          delete: false
          create: false
          configured: true
${MIGRATOR_SOURCE_BLOCK}
  logging:
    - output: stdout
      levels: "info|warning|error"
      apiLevels: disabled
    - output: "api-events.log"
      levels: disabled
    - output: "errors.log"
      levels: "error|warning"
      apiLevels: disabled
auth:
  methods:
    noauth: true
userDefaults:
  fileViewer:
    editorQuickSave: true
    autoplayMedia: true
  sidebar:
    disableQuickToggles: false
  search:
    disableOptions: false
  ui:
    darkMode: false
    locale: "en"
  listing:
    showHidden: true
    quickDownload: true
  preview:
    highQuality: true
    image: true
    video: true
    motionVideoPreview: true
    popup: true
    folder: true
  account:
    permissions:
      api: true
      admin: true
      share: true
      realtime: true
