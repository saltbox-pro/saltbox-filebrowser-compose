# shellcheck disable=SC2034

################################################################################
## FileBrowser settings
################################################################################

FILEBROWSER_IMAGE_TAG='dev'
FILEBROWSER_PROXY_IMAGE_TAG='dev'
FILEBROWSER_ADAPTER_IMAGE_TAG='dev'
FILEBROWSER_FRONTEND_IMAGE_TAG='dev'
FILEBROWSER_COMPOSE_DIR='../saltbox-filebrowser-compose'

# The Gateway talks to FileBrowser through the proxy, it enriches the
# `/public/api/users` response with the `readOnly` flag of every source
FILEBROWSER_HOST='saltbox-filebrowser-proxy'
FILEBROWSER_PORT=80
FILEBROWSER_BASE_ROUTE=''

# Flag to enable `/srv/migrator` source directory of Salt files related to the migration process
FILEBROWSER_MIGRATOR_SOURCE_ENABLED=false

################################################################################
## Discovery settings
################################################################################

FILEBROWSER_SERVICE_NAME='filebrowser'
FILEBROWSER_SERVICE_TITLE='FileBrowser'
FILEBROWSER_SERVICE_DESCRIPTION='Third-party file browser service'
FILEBROWSER_SERVICE_VENDOR='FileBrowser'
FILEBROWSER_INSTANCE_ID='a3f7c1e2d4b6489ea1c3e5f7d9b2a4c6'
FILEBROWSER_ADAPTER_BUILD_DIR='../saltbox-filebrowser-adapter'


################################################################################
## SaltBox.Compose specific
################################################################################

COMPOSE_FILE="${COMPOSE_FILE}:${FILEBROWSER_COMPOSE_DIR}/compose.yaml"
